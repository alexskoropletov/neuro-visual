# GPU host in LAN
OLLAMA_HOST=http://192.168.0.100:11434
COMFYUI_URL=http://192.168.0.101:8188

# Two-step script pipeline (Russian → English expand → scene split)
OLLAMA_EXPAND_MODEL=qwen3.8:27b
OLLAMA_SPLIT_MODEL=dolphin-llama3
# Legacy alias for expand model if OLLAMA_EXPAND_MODEL unset:
# OLLAMA_MODEL=qwen3.8:27b

# UI on this machine (0.0.0.0 = LAN access)
VIDEOMAKE_HOST=0.0.0.0
VIDEOMAKE_PORT=8765

# Do not start local Ollama/ComfyUI (use remote URLs above)
VIDEOMAKE_REMOTE=1

# Leonardo.ai — reference stills for each scene (I2V start frames)
LEONARDO_API_KEY=
LEONARDO_MODEL_ID=

# Wan 2.2 / ComfyUI quality knobs (UI + /api/generate wan{})
# WAN_STEPS=40
# WAN_CFG=5
# WAN_SHIFT=8
# WAN_WIDTH=832
# WAN_HEIGHT=480
# WAN_LENGTH=81
# WAN_SEED=-1
# WAN_SAMPLER=uni_pc
# WAN_SCHEDULER=simple
# WAN_DENOISE=1.0
# WAN_FPS=24
# WAN_UNET=wan2.2_ti2v_5B_fp16.safetensors
# WAN_CLIP=umt5_xxl_fp8_e4m3fn_scaled.safetensors
# WAN_VAE=wan2.2_vae.safetensors
# WAN_WEIGHT_DTYPE=default
